# Cached pokemontcg.io card catalog — large; regenerate on demand (build.py, or --refresh).
# `.partial` is the in-progress crash-resume checkpoint (built page-by-page during --refresh).
ptcg_cards.json
ptcg_cards.json.partial

# Raw Bulbapedia "<Name> (TCG)" wikitext per Pokémon — large; regenerated by scrape_bulbapedia.py.
# parse_bulbapedia.py reads this offline to produce the tracked bulbapedia_first_sets.json.
bulbapedia_raw.json

# Cache of resolved TCGplayer product URLs (build.py turns pokemontcg.io's affiliate
# redirects into direct tcgplayer.com links once per card and keeps them here).
tcgplayer_url_cache.json

# Generated output / scratch — derivable from the scripts + caches.
pokedex.csv
first_sets_preview.csv
ptcg_sets.json

# Python
__pycache__/
*.pyc

# NOTE: bulbapedia_first_sets.json IS tracked on purpose — build.py needs it and the upstream
# raw scrape (~1025 Bulbapedia pages) is expensive. parse_bulbapedia.py rebuilds it offline
# from bulbapedia_raw.json once that exists.

# Generated by shopping_list.py — the not-yet-owned TCGplayer click list (derivable).
pokedex_shopping.html
